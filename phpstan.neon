includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - filechi.php
        - uninstall.php
        - includes/
    excludePaths:
        analyse:
            - includes/vendor/*
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    scanFiles:
        - includes/vendor/woocommerce/action-scheduler/functions.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    ignoreErrors:
        # PHPStan stub limitation: CURLOPT_FTP_CREATE_MISSING_DIRS accepts integer constants (e.g. CURLFTP_CREATE_DIR_RETRY = 2), but phpstan stubs annotate parameter #3 as bool
        -
            message: '#Parameter \#3 \$value of function curl_setopt expects bool, int given\.#'
            path: includes/storage/class-filechi-storage-ftps.php
        # Runtime guard for PHP < 7.4: condition evaluates as false on modern CLI runtime during static analysis
        -
            message: '#If condition is always false\.#'
            path: filechi.php
